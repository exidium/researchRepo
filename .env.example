# Postgres connection used by Prisma (CLI and runtime)
DATABASE_URL="postgresql://brunoboeger@localhost:5432/research?schema=public"

# Dev auth seam: resolves the seeded dev user instead of a session. Refused in production.
AUTH_DISABLED=true
# Which seeded user the dev seam resolves: admin | editor | viewer
DEV_USER=admin
# Password the seed gives the dev users. Leave unset on servers so they cannot sign in.
DEV_PASSWORD=password12

# Where transcripts and recordings are stored (per-source folders)
UPLOAD_DIR=./uploads
MAX_TRANSCRIPT_BYTES=20000000
MAX_RECORDING_BYTES=2000000000

# Mirror folder the seed imports (Dovetail-mirror shape). Default is the synthetic one.
MIRROR_DIR=./fixtures/mirror
# AI suggestions (decision D59). Set ANTHROPIC_API_KEY to enable them with Claude; transcript text is then
# sent to Anthropic when someone asks for suggestions. AI_PROVIDER=fake uses an offline keyword matcher (dev and tests).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_PROVIDER=fake
# AI_SUGGESTIONS=off      # turns the feature off even when a key is set
# AI_AUTO_SUGGEST=off     # no automatic run when a transcription finishes
